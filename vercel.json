{
  "functions": {
    "api/index.py": { "maxDuration": 300, "includeFiles": "backend/**" }
  },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index" }],
  "crons": [
    { "path": "/api/cron/scan", "schedule": "0 13 * * *" },
    { "path": "/api/cron/digest", "schedule": "0 14 * * 1,4" }
  ]
}
