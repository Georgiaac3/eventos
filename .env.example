# ── Claude ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=            # e.g. your Parley endpoint; empty = api.anthropic.com

# ── Database (Supabase Postgres) ───────────────────────
# Supabase → Connect. The app uses the transaction pooler (port 6543), which suits Vercel's serverless functions.
# Locally you can point this at any Postgres instead, e.g. postgresql://localhost/eventos
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Migrations (alembic) need the session pooler (port 5432) or the direct connection. Falls back to DATABASE_URL.
MIGRATIONS_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── Login (Supabase Auth) ──────────────────────────────
# Leave all four empty for local dev without login (everything runs as one dev user).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_SECRET=           # only if your project still uses the legacy HS256 JWT secret
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # Supabase → Project Settings → API Keys (or the legacy anon key)

# ── Optional ───────────────────────────────────────────
CRON_SECRET=
RESEND_API_KEY=
NOTIFY_WEBHOOK_URL=
SIGNUP_MODE=dry-run
